#include <iostream>
using namespace std;

class SinglelinkedList {
    struct Node {
        int data;
        Node* next;

        Node(int value) : data(value), next(nullptr) {}
    };

    Node* head = nullptr;

public:

    // Insert at beginning
    void insertFront(int value) {
        Node* node = new Node(value);
        node->next = head;
        head = node;
    }

    // Insert at end
    void insertEnd(int value) {
        Node* node = new Node(value);

        if (!head) {
            head = node;
            return;
        }

        Node* cur = head;

        while (cur->next)
            cur = cur->next;

        cur->next = node;
    }

    // Search for a value
    bool search(int value) const {
        for (Node* cur = head; cur; cur = cur->next) {
            if (cur->data == value)
                return true;
        }

        return false;
    }

    // Delete a value
    void deletevalue(int value) {

        // If list is empty
        if (!head)
            return;

        // If value is in the first node
        if (head->data == value) {
            Node* temp = head;
            head = head->next;
            delete temp;
            return;
        }

        // Search for the node before the target
        Node* cur = head;

        while (cur->next && cur->next->data != value)
            cur = cur->next;

        // If value was found
        if (cur->next) {
            Node* temp = cur->next;
            cur->next = temp->next;
            delete temp;
        }
    }

    // Display the list
    void display() const {
        for (Node* cur = head; cur; cur = cur->next)
            cout << cur->data << "->";

        cout << "NULL\n";
    }

    // Destructor
    ~SinglelinkedList() {
        while (head) {
            Node* temp = head;
            head = head->next;
            delete temp;
        }
    }
};

int main() {

    SinglelinkedList list;

    list.insertFront(20);
    list.insertFront(10);

    list.insertEnd(30);
    list.insertEnd(40);

    cout << "Original List: ";
    list.display();
    cout << "Search 30: "
         << (list.search(30) ? "Found" : "Not Found")
         << '\n';

    list.deletevalue(20);

    cout << "After deleting 20: ";
    list.display();

    return 0;
}
