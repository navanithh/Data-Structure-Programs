class Main {

 public static void main(String args[]) {
 int a[] = {5, 1, 4, 2, 8};
 selectionSort(a);
 }

 public static void selectionSort(int[] arr) {

 int n = arr.length;

 for (int i = 0; i < n - 1; i++) {
  
  int minIndex = i;

 for (int j = 0; j < n - 1; j++) {

 if (arr[j] > arr[minIndex]) {
  minIndex = j;
 }
 }

 int temp = arr[i];
 arr[i] = arr[minIndex];
 arr[minIndex] = temp;
 }
 for(int i:arr)
 System.out.println(i);
 }
}
