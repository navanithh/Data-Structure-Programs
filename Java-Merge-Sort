class Main {

    public static void main(String[] args) {

        int a[] = {5, 1, 4, 2, 8};

        mergeSort(a, 0, a.length - 1);

        for (int i : a)
            System.out.print(i + " ");
    }

    static void mergeSort(int a[], int low, int high) {

        if (low < high) {

            int mid = (low + high) / 2;

            mergeSort(a, low, mid);
            mergeSort(a, mid + 1, high);

            int i = low, j = mid + 1;
            int temp[] = new int[high - low + 1];
            int k = 0;

            while (i <= mid && j <= high) {
                if (a[i] < a[j])
                    temp[k++] = a[i++];
                else
                    temp[k++] = a[j++];
            }

            while (i <= mid)
                temp[k++] = a[i++];

            while (j <= high)
                temp[k++] = a[j++];

            for (i = low, k = 0; i <= high; i++)
                a[i] = temp[k++];
        }
    }
}
