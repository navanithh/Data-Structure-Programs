#include <iostream>
using namespace std;

class stack {

private:
int arr[5];
int top;

public:
 stack() {
    top = -1;
 }
int main() 

//push()
void push(int value){
    if(top == 4){
        cout << "Stack Overflow" << endl;
        return;
    }
    top++;
    arr[top] = value;
    cout << value << " pushed into stack" << endl;
}

//pop()
void pop(int value){
    if(top == -1){
        cout << "Stack Underflow" << endl;
        return;
    }
    cout << arr[top] << value << "poped from stack" << endl;
    top--;
}

//peek()
void peek(int value)
{
    if(top == -1){
    cout<< "Stack is Empty" << endl;
    return;
    }
    cout<< "Top element: "
    << arr[top] << endl;
}

//display()
void display() {
    if(top == -1){
        cout<< "Stack elements: " << endl;
        for(int i = top; i >= 0; i--){
            cout<< arr[i] << endl;
        }
    }
}
};

int main() {
    Stack stack;
    stack.push(10);
    stack.push(20);
    stack.push(30);
    stack.push(40);
    
